// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DONOR
  ADMIN
}

enum Language {
  EN
  HI
}

enum SchemeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CampaignStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum DonationType {
  ONE_TIME
  MONTHLY
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum AIReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HelpRequestStatus {
  PENDING
  CONTACTED
  RESOLVED
}

model User {
  id                String       @id @default(uuid())
  fullName          String
  email             String       @unique
  phone             String?
  passwordHash      String
  role              Role         @default(DONOR)
  preferredLanguage Language     @default(HI)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  donations         Donation[]
  aiReviews         AIReview[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([role])
}

model Campaign {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  description     String
  category        String
  imageUrl        String?
  goalAmount      Decimal        @db.Decimal(12, 2)
  collectedAmount Decimal        @default(0) @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime?
  status          CampaignStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  donations       Donation[]

  @@index([status])
  @@index([slug])
}

model Scheme {
  id                  String       @id @default(uuid())
  schemeCode          String       @unique
  name                String
  nameHi              String?
  slug                String       @unique
  category            String
  need                String
  description         String
  descriptionHi       String?
  benefit             String
  benefitHi           String?
  eligibilityRules    Json
  requiredDocuments   Json
  applicationSteps    Json
  applicableDistricts Json
  officialSourceUrl   String
  nearestHelpCentre   Json
  lastCheckedAt       DateTime
  status              SchemeStatus @default(PUBLISHED)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  aiReviews           AIReview[]

  @@index([status, category])
  @@index([slug])
  @@index([schemeCode])
}

model Donation {
  id               String         @id @default(uuid())
  donorId          String?
  donor            User?          @relation(fields: [donorId], references: [id], onDelete: Restrict)
  campaignId       String
  campaign         Campaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  amount           Decimal        @db.Decimal(12, 2)
  currency         String         @default("INR")
  donationType     DonationType   @default(ONE_TIME)
  status           DonationStatus @default(PENDING)
  idempotencyKey   String?        @unique
  paymentReference String?
  paymentMethod    String?
  donorName        String
  donorEmail       String
  donorPhone       String
  donorPAN         String
  donorAddress     String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  payments         Payment[]
  receipt          Receipt?

  @@index([donorId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
  @@index([idempotencyKey])
}

model Payment {
  id                   String        @id @default(uuid())
  donationId           String
  donation             Donation      @relation(fields: [donationId], references: [id], onDelete: Restrict)
  provider             String        @default("MOCK_PAYMENT_SIMULATOR")
  transactionReference String        @unique
  status               PaymentStatus
  responseMetadata     Json
  createdAt            DateTime      @default(now())

  @@index([donationId])
  @@index([transactionReference])
}

model Receipt {
  id                         String    @id @default(uuid())
  donationId                 String    @unique
  donation                   Donation  @relation(fields: [donationId], references: [id], onDelete: Restrict)
  receiptNumber              String    @unique
  donorName                  String
  donorPAN                   String
  donationAmount             Decimal   @db.Decimal(12, 2)
  trustPAN                   String
  trust80GRegistrationNumber String
  financialYear              String
  pdfStorageKey              String?
  pdfPath                    String?
  issuedAt                   DateTime  @default(now())

  @@index([receiptNumber])
  @@index([financialYear])
}

model ReceiptSequence {
  id            String   @id @default(uuid())
  financialYear String   @unique
  nextNumber    Int      @default(1)
  updatedAt     DateTime @updatedAt
}

model AIReview {
  id                     String         @id @default(uuid())
  schemeId               String
  scheme                 Scheme         @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  generatedHindiSummary  String
  generatedEnglishSummary String
  missingInformation     Json?
  status                 AIReviewStatus @default(PENDING)
  reviewedById           String?
  reviewedBy             User?          @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([schemeId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model HelpRequest {
  id          String            @id @default(uuid())
  name        String
  phone       String
  district    String
  schemeCode  String?
  notes       String?
  status      HelpRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

